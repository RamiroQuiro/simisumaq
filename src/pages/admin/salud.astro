---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/client";
import { configuracion } from "../../db/schema";
import { eq, inArray } from "drizzle-orm";

const keys = ["fonoaudiologia", "psicologia", "psicopedagogia"];
const rows = await db.select().from(configuracion).where(inArray(configuracion.key, keys));

const secciones = keys.map((key) => {
  const row = rows.find((r) => r.key === key);
  const data = row ? JSON.parse(row.value) : { titulo: "", texto: "", imagen: "" };
  return { key, ...data };
});

const labels: Record<string, string> = {
  fonoaudiologia: "Fonoaudiología",
  psicologia: "Psicología",
  psicopedagogia: "Psicopedagogía",
};
---

<AdminLayout title="Secciones de Salud">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Secciones de Salud</h1>
    <p class="text-gray-500 mt-1">Editá el contenido de Fonoaudiología, Psicología y Psicopedagogía</p>
  </div>

  <div class="space-y-6">
    {secciones.map((seccion) => (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">{labels[seccion.key]}</h2>

        <form class="seccion-form space-y-6" data-key={seccion.key}>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
            <input
              type="text"
              name="titulo"
              value={seccion.titulo}
              class="w-full px-3 py-2 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Texto</label>
            <textarea
              name="texto"
              rows="4"
              class="w-full px-3 py-2 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            >{seccion.texto}</textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Imagen (opcional)</label>
            {seccion.imagen && (
              <div class="mb-2">
                <label class="block text-xs text-gray-500 mb-1">Imagen actual</label>
                <div class="relative w-48 h-32 rounded-lg overflow-hidden border border-gray-200">
                  <img src={seccion.imagen} alt={seccion.titulo} class="w-full h-full object-cover" />
                </div>
              </div>
            )}
            <div class="dropzone border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-red-400 transition-colors cursor-pointer">
              <svg class="h-8 w-8 text-gray-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm text-gray-500">Click o arrastrá una imagen</p>
              <p class="text-xs text-gray-400 mt-1">Se optimiza automáticamente a WebP</p>
              <input type="file" accept="image/*" class="hidden file-input" />
            </div>
            <div class="preview mt-3 flex justify-center"></div>
            <input type="hidden" name="imagen" class="imagen-url" value={seccion.imagen || ""} />
          </div>

          <div class="status hidden text-sm text-center py-2"></div>

          <div class="flex gap-3">
            <button
              type="submit"
              class="submit-btn px-4 py-2.5 rounded-lg bg-gradient-to-r from-red-500 to-orange-500 text-white text-sm font-medium hover:from-red-600 hover:to-orange-600 transition-all"
            >
              Guardar {labels[seccion.key]}
            </button>
          </div>
        </form>
      </div>
    ))}
  </div>

  <script is:inline>
    document.querySelectorAll(".seccion-form").forEach((form) => {
      const dropzone = form.querySelector(".dropzone");
      const fileInput = form.querySelector(".file-input");
      const preview = form.querySelector(".preview");
      const imagenUrl = form.querySelector(".imagen-url");
      const status = form.querySelector(".status");
      const submitBtn = form.querySelector(".submit-btn");

      dropzone.addEventListener("click", () => fileInput.click());
      dropzone.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("border-red-400", "bg-red-50"); });
      dropzone.addEventListener("dragleave", () => dropzone.classList.remove("border-red-400", "bg-red-50"));
      dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.classList.remove("border-red-400", "bg-red-50");
        if (e.dataTransfer.files.length) { fileInput.files = e.dataTransfer.files; fileInput.dispatchEvent(new Event("change")); }
      });
      fileInput.addEventListener("change", () => {
        preview.innerHTML = "";
        if (fileInput.files.length) {
          const thumb = document.createElement("div");
          thumb.className = "relative w-48 h-32 rounded-lg overflow-hidden border border-gray-200";
          const img = document.createElement("img");
          img.className = "w-full h-full object-cover";
          img.src = URL.createObjectURL(fileInput.files[0]);
          thumb.appendChild(img);
          preview.appendChild(thumb);
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const key = form.dataset.key;
        submitBtn.disabled = true;
        status.textContent = "Guardando...";
        status.className = "status text-sm text-center py-2 text-gray-500";
        status.classList.remove("hidden");

        try {
          let url = imagenUrl.value;
          if (fileInput.files.length) {
            const formData = new FormData();
            formData.append("file", fileInput.files[0]);
            const res = await fetch("/api/upload", { method: "POST", body: formData });
            if (!res.ok) throw new Error("Error al subir imagen");
            const data = await res.json();
            url = data.url;
          }

          const config = {
            titulo: form.titulo.value,
            texto: form.texto.value,
            imagen: url,
          };

          const saveRes = await fetch("/api/configuracion", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ key, value: JSON.stringify(config) }),
          });
          if (!saveRes.ok) throw new Error("Error al guardar");

          status.textContent = "Guardado correctamente";
          status.className = "status text-sm text-center py-2 text-green-600";
          setTimeout(() => window.location.reload(), 800);
        } catch (err) {
          status.textContent = err.message;
          status.className = "status text-sm text-center py-2 text-red-600";
          submitBtn.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>

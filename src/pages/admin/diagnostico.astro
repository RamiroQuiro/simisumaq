---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/client";
import { configuracion } from "../../db/schema";
import { eq } from "drizzle-orm";

const rows = await db.select().from(configuracion).where(eq(configuracion.key, "diagnostico"));
const config = rows[0] ? JSON.parse(rows[0].value) : { titulo: "Diagnóstico", texto: "", imagen: "" };
---

<AdminLayout title="Diagnóstico">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Sección Diagnóstico</h1>
    <p class="text-gray-500 mt-1">Editá el contenido de la página de diagnóstico</p>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Contenido de la página</h2>

      <form id="diagnostico-form" class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
          <input
            type="text"
            name="titulo"
            value={config.titulo}
            class="w-full px-3 py-2 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Texto descriptivo</label>
          <textarea
            name="texto"
            rows="4"
            class="w-full px-3 py-2 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
          >{config.texto}</textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Imagen (ecografía)</label>
          {config.imagen && (
            <div class="mb-2">
              <label class="block text-xs text-gray-500 mb-1">Imagen actual</label>
              <div class="relative w-48 h-32 rounded-lg overflow-hidden border border-gray-200 group/img">
                <img src={config.imagen} alt="Diagnóstico actual" class="w-full h-full object-cover" />
              </div>
            </div>
          )}
          <div id="diagnostico-dropzone" class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-red-400 transition-colors cursor-pointer">
            <svg class="h-8 w-8 text-gray-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm text-gray-500">Click o arrastrá una imagen</p>
            <p class="text-xs text-gray-400 mt-1">Se optimiza automáticamente a WebP</p>
            <input type="file" accept="image/*" class="hidden" id="diagnostico-file-input" />
          </div>
          <div id="diagnostico-preview" class="mt-3 flex justify-center"></div>
          <input type="hidden" name="imagen" id="diagnostico-imagen-url" value={config.imagen || ""} />
        </div>

        <div id="diagnostico-status" class="hidden text-sm text-center py-2"></div>

        <div class="flex gap-3">
          <button
            type="submit"
            id="diagnostico-submit"
            class="px-4 py-2.5 rounded-lg bg-gradient-to-r from-red-500 to-orange-500 text-white text-sm font-medium hover:from-red-600 hover:to-orange-600 transition-all"
          >
            Guardar cambios
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function setupDiagnosticoDropzone() {
      const dropzone = document.getElementById("diagnostico-dropzone");
      const input = document.getElementById("diagnostico-file-input");
      const preview = document.getElementById("diagnostico-preview");

      dropzone.addEventListener("click", () => input.click());
      dropzone.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("border-red-400", "bg-red-50"); });
      dropzone.addEventListener("dragleave", () => dropzone.classList.remove("border-red-400", "bg-red-50"));
      dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.classList.remove("border-red-400", "bg-red-50");
        if (e.dataTransfer.files.length) { input.files = e.dataTransfer.files; input.dispatchEvent(new Event("change")); }
      });
      input.addEventListener("change", () => {
        preview.innerHTML = "";
        if (input.files.length) {
          const file = input.files[0];
          const thumb = document.createElement("div");
          thumb.className = "relative w-48 h-32 rounded-lg overflow-hidden border border-gray-200";
          const img = document.createElement("img");
          img.className = "w-full h-full object-cover";
          img.src = URL.createObjectURL(file);
          thumb.appendChild(img);
          preview.appendChild(thumb);
        }
      });
    }

    setupDiagnosticoDropzone();

    document.getElementById("diagnostico-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const status = document.getElementById("diagnostico-status");
      const submitBtn = document.getElementById("diagnostico-submit");

      submitBtn.disabled = true;
      status.textContent = "Guardando...";
      status.className = "text-sm text-center py-2 text-gray-500";
      status.classList.remove("hidden");

      try {
        let imagenUrl = document.getElementById("diagnostico-imagen-url").value;
        const fileInput = document.getElementById("diagnostico-file-input");

        if (fileInput.files.length) {
          const formData = new FormData();
          formData.append("file", fileInput.files[0]);
          const res = await fetch("/api/upload", { method: "POST", body: formData });
          if (!res.ok) throw new Error("Error al subir imagen");
          const data = await res.json();
          imagenUrl = data.url;
        }

        const config = {
          titulo: form.titulo.value,
          texto: form.texto.value,
          imagen: imagenUrl,
        };

        const saveRes = await fetch("/api/configuracion", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ key: "diagnostico", value: JSON.stringify(config) }),
        });
        if (!saveRes.ok) throw new Error("Error al guardar");

        status.textContent = "Guardado correctamente";
        status.className = "text-sm text-center py-2 text-green-600";
        setTimeout(() => window.location.reload(), 1000);
      } catch (err) {
        status.textContent = err.message;
        status.className = "text-sm text-center py-2 text-red-600";
        submitBtn.disabled = false;
      }
    });
  </script>
</AdminLayout>

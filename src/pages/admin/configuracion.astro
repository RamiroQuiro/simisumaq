---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/client";
import { configuracion } from "../../db/schema";
import { eq } from "drizzle-orm";

const rows = await db.select().from(configuracion).where(eq(configuracion.key, "hero_image"));
const heroImage = rows[0]?.value || "/hero-image.webp";
---

<AdminLayout title="Configuración">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Configuración del sitio</h1>
    <p class="text-gray-500 mt-1">Personalizá la apariencia de la landing page</p>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Portada de la landing page</h2>
      <p class="text-sm text-gray-500 mb-4">Imagen de fondo de la sección principal (hero). Se recomienda usar una imagen horizontal de buena calidad.</p>

      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Vista previa actual</label>
        <div class="relative w-full h-48 rounded-xl overflow-hidden border border-gray-200">
          <img src={heroImage} alt="Portada actual" class="w-full h-full object-cover" />
        </div>
      </div>

      <form id="hero-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nueva imagen de portada</label>
          <div id="hero-dropzone" class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-red-400 transition-colors cursor-pointer">
            <svg class="h-8 w-8 text-gray-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm text-gray-500">Click o arrastrá una nueva imagen de portada</p>
            <p class="text-xs text-gray-400 mt-1">Formatos de imagen. Se optimiza automáticamente a WebP.</p>
            <input type="file" accept="image/*" class="hidden" id="hero-file-input" />
          </div>
          <div id="hero-preview" class="mt-3 flex justify-center"></div>
        </div>
        <div id="hero-status" class="hidden text-sm text-center py-2"></div>
        <div class="flex gap-3">
          <button type="submit" id="hero-submit" class="px-4 py-2.5 rounded-lg bg-gradient-to-r from-red-500 to-orange-500 text-white text-sm font-medium hover:from-red-600 hover:to-orange-600 transition-all">
            Guardar portada
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function setupHeroDropzone() {
      const dropzone = document.getElementById("hero-dropzone");
      const input = document.getElementById("hero-file-input");
      const preview = document.getElementById("hero-preview");

      dropzone.addEventListener("click", () => input.click());
      dropzone.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("border-red-400", "bg-red-50"); });
      dropzone.addEventListener("dragleave", () => dropzone.classList.remove("border-red-400", "bg-red-50"));
      dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.classList.remove("border-red-400", "bg-red-50");
        if (e.dataTransfer.files.length) { input.files = e.dataTransfer.files; input.dispatchEvent(new Event("change")); }
      });
      input.addEventListener("change", () => {
        preview.innerHTML = "";
        if (input.files.length) {
          const file = input.files[0];
          const thumb = document.createElement("div");
          thumb.className = "relative w-full h-48 rounded-lg overflow-hidden border border-gray-200";
          const img = document.createElement("img");
          img.className = "w-full h-full object-cover";
          img.src = URL.createObjectURL(file);
          thumb.appendChild(img);
          preview.appendChild(thumb);
        }
      });
    }

    setupHeroDropzone();

    document.getElementById("hero-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const fileInput = document.getElementById("hero-file-input");
      const status = document.getElementById("hero-status");
      const submitBtn = document.getElementById("hero-submit");

      if (!fileInput.files.length) {
        status.textContent = "Seleccioná una imagen primero";
        status.className = "text-sm text-center py-2 text-red-600";
        status.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      status.textContent = "Subiendo imagen...";
      status.className = "text-sm text-center py-2 text-gray-500";
      status.classList.remove("hidden");

      try {
        const file = fileInput.files[0];
        const formData = new FormData();
        formData.append("file", file);

        const res = await fetch("/api/upload", { method: "POST", body: formData });
        if (!res.ok) {
          let msg = "Error al subir";
          try { const errData = await res.json(); if (errData.error) msg = errData.error; } catch {}
          throw new Error(msg);
        }
        let url;
        try { const data = await res.json(); url = data.url; } catch { throw new Error("Respuesta inesperada del servidor"); }

        const saveRes = await fetch("/api/configuracion", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ key: "hero_image", value: url }),
        });
        if (!saveRes.ok) throw new Error("Error al guardar la configuración");

        status.textContent = "Portada actualizada correctamente. Refrescá la página de inicio para ver los cambios.";
        status.className = "text-sm text-center py-2 text-green-600";
        window.location.reload();
      } catch (err) {
        status.textContent = err.message;
        status.className = "text-sm text-center py-2 text-red-600";
        submitBtn.disabled = false;
      }
    });
  </script>
</AdminLayout>
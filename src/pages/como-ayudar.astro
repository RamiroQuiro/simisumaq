---
export const prerender = true;
import Layout from "../layouts/LayoutSeo.astro";
import Navbar from "../components/organismos/Navbar.astro";
import Section from "../components/organismos/Section.astro";
import Button from "../components/atomos/Button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "../components/organismos/Card";
import {
  DollarSign,
  Calendar,
  Users,
  Share2,
} from "lucide-react";

const ways = [
  {
    icon: DollarSign,
    title: "Donación Única",
    description:
      "Haz una diferencia inmediata con una donación única. $150.000 puede cambiar una vida para siempre.",
    action: "Donar Ahora",
    href: "https://wa.me/543855063501?text=Hola,%20quiero%20hacer%20una%20donaci%C3%B3n%20%C3%BAnica",
  },
  {
    icon: Calendar,
    title: "Donación Mensual",
    description:
      "Únete a nuestra comunidad de patrocinadores mensuales con $1500 o anual $16000 para todo el año.",
    action: "Ser Patrocinador",
    href: "https://wa.me/543855063501?text=Hola,%20quiero%20ser%20patrocinador",
  },
  {
    icon: Users,
    title: "Voluntariado",
    description:
      "Profesionale de diferentes áreas pueden unirse a nuestras misiones y apoyar en diferentes actividades.",
    action: "Únete al Equipo",
    href: "https://wa.me/543855063501?text=Hola,%20quiero%20unirme%20como%20voluntario",
  },
  {
    icon: Share2,
    title: "Comparte Nuestra Causa",
    description:
      "Ayúdanos a llegar a más personas compartiendo nuestro trabajo en redes sociales.",
    action: "Compartir",
    href: "https://wa.me/543855063501?text=Hola,%20quiero%20ayudar%20a%20difundir%20su%20causa",
  },
];
---

<Layout
  title="Como ayudar | Donaciones, voluntariado y patrocinio - Simi Sumaq"
  description="Conoce formas concretas de ayudar: donaciones, voluntariado y patrocinio para que mas ninos accedan a tratamiento integral."
  canonical="https://simisumq.org/como-ayudar"
>
  <div class="text-center text-primary-textoTitle py-30">
    <h1 class="text-5xl md:text-6xl font-bold mb-6">¿Cómo puedes ayudar?</h1>
    <p class="text-xl md:text-2xl max-w-3xl mx-auto opacity-90">
      Tu generosidad es la llave que abre un futuro lleno de sonrisas
    </p>
  </div>

  <Section id="formas" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-4xl md:text-5xl font-bold text-foreground mb-12 text-center"
      >
        Formas de Colaborar
      </h2>

      <div class="grid md:grid-cols-2 gap-8 mb-16">
        {
          ways.map((way) => {
            const Icon = way.icon;
            return (
              <Card className="border-2 hover:border-primary-100 transition-all hover:shadow-medium group">
                <CardHeader>
                  <div class="w-14 h-14 rounded-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <Icon className="h-7 w-7 text-white" />
                  </div>
                  <CardTitle className="text-2xl">{way.title}</CardTitle>
                  <CardDescription className="text-base leading-relaxed">
                    {way.description}
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <Button
                    href={way.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="w-full"
                  >
                    {way.action}
                  </Button>
                </CardContent>
              </Card>
            );
          })
        }
      </div>
    </div>
  </Section>

  <Section id="voluntariado" class="py-24 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-6">
        Únete como Voluntario
      </h2>
      <p class="text-xl text-muted-foreground mb-12">
        Si eres profesional de la salud, estudiante o simplemente quieres donar
        tu tiempo, hay un lugar para ti en Simi Sumaq.
      </p>
      <Button
        href="https://wa.me/543855063501?text=Hola,%20quiero%20unirme%20como%20voluntario"
        target="_blank"
        rel="noopener noreferrer"
        size="lg"
        variant="primary"
        className="text-lg px-12 py-6 shadow-strong"
      >
        Quiero ser Voluntario
      </Button>
    </div>
  </Section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Section from "../components/organismos/Section.astro";
import { db } from "../db/client";
import { configuracion } from "../db/schema";
import { eq } from "drizzle-orm";

const rows = await db.select().from(configuracion).where(eq(configuracion.key, "diagnostico"));
const config = rows[0] ? JSON.parse(rows[0].value) : {
  titulo: "Diagnóstico",
  texto: "La detección temprana de la fisura labiopalatina es fundamental para garantizar una atención integral oportuna.",
  imagen: "",
};
---

<Layout title={`${config.titulo} | Simi Sumaq`}>
  <Section class="bg-primary-bg-claro min-h-screen">
    <div class="max-w-5xl mx-auto my-24">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-primary-textoTitle mb-6">
            {config.titulo}
          </h1>
          <p class="text-lg text-primary-texto leading-relaxed">
            {config.texto}
          </p>
        </div>

        {config.imagen && (
          <div>
            <img
              src={config.imagen}
              alt="Diagnóstico"
              class="w-full h-auto rounded-2xl shadow-strong"
            />
          </div>
        )}
      </div>
    </div>
  </Section>
</Layout>

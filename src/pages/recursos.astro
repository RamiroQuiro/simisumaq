---
import Layout from "../layouts/Layout.astro";
import Section from "../components/organismos/Section.astro";
import { db } from "../db/client";
import { recursos } from "../db/schema";
import { desc } from "drizzle-orm";

const items = await db.select().from(recursos).orderBy(desc(recursos.fecha));
---

<Layout title="Recursos | Simi Sumaq" description="Descargá flayers, guías y materiales útiles para pacientes y familias con labio y/o paladar hendido.">
  <Section class="bg-primary-bg-claro min-h-screen">
    <div class="max-w-5xl mx-auto my-24">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-primary-textoTitle mb-4">
          Recursos
        </h1>
        <p class="text-lg text-primary-textoBody max-w-2xl mx-auto">
          Descargá flyers, guías y materiales útiles para pacientes y familias.
        </p>
      </div>

      {items.length === 0 ? (
        <div class="text-center py-16 text-primary-texto opacity-60">
          <svg class="h-16 w-16 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <p class="text-xl">Próximamente</p>
          <p class="mt-2">Estamos preparando recursos para vos.</p>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((item) => (
            <a
              href={item.archivo}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white rounded-2xl border border-primary-border p-6 hover:shadow-lg hover:border-primary-100 transition-all group"
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center shrink-0 group-hover:bg-red-100 transition-colors">
                  <svg class="h-6 w-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    {item.categoria && (
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                        {item.categoria}
                      </span>
                    )}
                  </div>
                  <h3 class="font-semibold text-primary-textoTitle group-hover:text-primary-100 transition-colors">
                    {item.titulo}
                  </h3>
                  {item.descripcion && (
                    <p class="text-sm text-primary-texto mt-1 line-clamp-2">{item.descripcion}</p>
                  )}
                  <p class="text-xs text-gray-400 mt-2">{item.fecha}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </Section>
</Layout>

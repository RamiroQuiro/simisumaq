---
import { DollarSign, Calendar, Users, Share2 } from "lucide-react";
import Section from "../../components/organismos/Section.astro";
import Button from "../../components/atomos/Button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "../../components/organismos/Card";
import { db } from "../../db/client";
import { configuracion } from "../../db/schema";
import { eq } from "drizzle-orm";

const rows = await db.select().from(configuracion).where(eq(configuracion.key, "colaborar"));
const config = rows[0] ? JSON.parse(rows[0].value) : {
  titulo: "Cómo Puedes Ayudar",
  texto: "Hay muchas formas de contribuir a nuestra misión. Cada acción cuenta y juntos podemos transformar más vidas.",
  formas: [],
};

const defaultIcons = [DollarSign, Calendar, Users, Share2];
---

<Section id="ayudar">
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-6">
      {config.titulo}
    </h2>
    <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
      {config.texto}
    </p>
  </div>

  <div class="grid md:grid-cols-2 gap-8 mb-12">
    {
      config.formas.map((way: any, index: number) => {
        const Icon = defaultIcons[index % defaultIcons.length];
        return (
          <Card
            key={index}
            className="border-2 hover:border-primary-100 transition-all hover:shadow-medium"
          >
            <CardHeader>
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center mb-4">
                <Icon className="h-6 w-6 text-white" />
              </div>
              <CardTitle className="text-2xl">{way.titulo}</CardTitle>
              {way.monto && (
                <p class="text-primary font-bold text-lg">{way.monto}</p>
              )}
              <CardDescription className="text-base">
                {way.descripcion}
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Button
                variant="outline"
                href={way.href}
                target="_blank"
                rel="noopener noreferrer"
                className="w-full border-2"
              >
                {way.action}
              </Button>
            </CardContent>
          </Card>
        );
      })
    }
  </div>

  <div
    class="bg-gradient-to-r from-primary-100 to-primary-200 rounded-2xl p-12 text-center text-white shadow-strong"
  >
    <h3 class="text-3xl md:text-4xl font-bold mb-4">
      ¿Listo para hacer la diferencia?
    </h3>
    <p class="text-xl mb-8 opacity-90 max-w-2xl mx-auto">
      Tu donación puede darle a un niño la oportunidad de sonreír, de ir a la
      escuela y de perseguir sus sueños. Únete a nosotros hoy.
    </p>
    <Button
      href="https://wa.me/543855063501?text=Hola,%20quiero%20hacer%20una%20donaci%C3%B3n"
      target="_blank"
      rel="noopener noreferrer"
      size="lg"
      variant="secondary"
      className="text-lg px-12 py-6 shadow-strong"
    >
      Dona Ahora
    </Button>
  </div>
</Section>

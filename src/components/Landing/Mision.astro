---
import Section from "../../components/organismos/Section.astro";
---

<Section id="mision">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div class="order-2 lg:order-1">
      <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-6">
        Nuestra Misión
      </h2>
      <p class="text-lg text-muted-foreground mb-6 leading-relaxed">
        Acompañar a niños, niñas y familias que transitan la <span
          class="font-bolder text-primary-100"
          >fisura labio alvéolo palatina</span
        >, promoviendo una atención integral e interdisciplinaria, el acceso a
        información y orientación, y espacios que favorezcan su desarrollo,
        bienestar e inclusión.
      </p>
    </div>

    <div class="order-1 lg:order-2">
      <img
        src={"./mision.webp"}
        alt="Niños felices sonriendo juntos"
        class="w-full h-auto rounded-2xl shadow-strong"
      />
    </div>
  </div>
</Section>
